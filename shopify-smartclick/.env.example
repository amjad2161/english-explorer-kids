# Copy to .env in mobarshamhub (never commit .env)
# Obtain shpat_ token: Admin > Settings > Apps > Develop apps > Your app > Install

SHOPIFY_STORE=mobarsham.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_token_here

# Partners app (for CLI dev/deploy only - not Admin API)
SHOPIFY_API_KEY=your_partners_client_id
SHOPIFY_API_SECRET=shpss_your_secret_here
